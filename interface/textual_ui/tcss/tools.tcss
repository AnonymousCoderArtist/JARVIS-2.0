/* ========================================
   JARVIS Color Palette
   ======================================== */
$mistral_orange: #FF8205;
$accent: #FF8205;
$surface: #1a1a2e;
$surface-light: #16213e;
$text-primary: #e0e0e0;
$text-secondary: #8b8b9a;
$border-subtle: #2a2a3e;
$border-focus: #FF8205;
$success: #4ade80;
$warning: #facc15;
$error: #f87171;
$info: #60a5fa;

/* ========================================
   Tool Widgets Modern Styles
   ======================================== */

/* Generic Tool Result Widget */
.tool-result-widget {
    width: 100%;
    height: auto;
    color: $text-primary;
}

.tool-result-widget:focus {
    background: $border-subtle 30%;
}

/* Branch indicator for collapsed summaries */
.tool-result-summary {
    color: $text-primary;
    text-style: bold;
    padding-left: 2;
}

.tool-result-summary.collapsed {
    color: $info;
    background: $surface-light 30%;
    padding: 0 1;
}

.tool-result-summary.clickable {
    color: $info;
    text-style: bold;
    background: $surface-light 40%;
    padding: 0 1;
}

.tool-result-summary.clickable:hover {
    background: $surface-light 60%;
    color: $text-primary;
}

/* Muted text for empty states */
.tool-result-muted {
    color: $text-secondary;
    padding-left: 2;
}

/* Hint text */
.tool-result-hint {
    color: $text-secondary;
    text-style: italic;
    padding-left: 5;
}

/* Detail text */
.tool-result-detail {
    color: $text-secondary;
    padding-left: 2;
}

/* Warning/Error text */
.tool-result-warning {
    color: $warning;
    padding-left: 2;
}

.tool-result-error {
    color: $error;
    padding-left: 2;
}

/* Error text styling */
.error-text {
    color: $error;
}

.warning-text {
    color: $warning;
}

/* ========================================
   Bash Tool Styles
   ======================================== */

.approval-tool-name {
    height: auto;
    color: $info;
    text-style: bold;
    margin-left: 0;
}

.approval-bash-command {
    height: auto;
    margin-left: 2;
    margin-top: 1;
    color: $success;
    background: $surface-light 30%;
    padding: 0 1;
}

.approval-bash-param {
    height: auto;
    color: $text-secondary;
    margin-left: 2;
}

.bash-success {
    color: $text-secondary;
}

.bash-error {
    color: $error;
}

.bash-output-line {
    color: $text-secondary;
    padding-left: 3;
}

/* ========================================
   Grep Tool Styles
   ======================================== */

.approval-grep-query {
    height: auto;
    color: ansi_bright_green;
    text-style: bold;
    margin-left: 2;
}

.approval-grep-param {
    height: auto;
    color: ansi_bright_black;
    margin-left: 2;
}

.tool-result-match {
    color: $text-primary;
    padding-left: 5;
    background: $surface-light 15%;
}

/* ========================================
   LS Tool Styles
   ======================================== */

.tool-result-ls-item {
    padding-left: 5;
    margin-left: 0;
}

.tool-result-ls-dir {
    color: $info;
    text-style: bold;
}

.tool-result-ls-file {
    color: $text-primary;
}

.tool-result-ls-hint {
    color: $text-secondary;
    padding-left: 5;
    margin-left: 0;
    text-style: italic;
}

/* ========================================
   Find Tool Styles
   ======================================== */

/* Find uses same styles as LS */

/* ========================================
   Read File Tool Styles
   ======================================== */

.approval-read-file-count {
    color: $success;
    text-style: bold;
}

.tool-result-read-summary {
    color: $text-secondary;
    padding-left: 2;
}

.tool-result-read-warning {
    color: $warning;
    padding-left: 5;
}

/* ========================================
   Write File Tool Styles
   ======================================== */

/* Write uses same styles as Read */

/* ========================================
   Todo Tool Styles
   ======================================== */

.todo-in_progress {
    color: $warning;
}

.todo-pending {
    color: $text-primary;
}

.todo-completed {
    color: $success;
}

.todo-cancelled,
.todo-empty {
    color: $text-secondary;
}

/* ========================================
   Ask User Question Styles
   ======================================== */

.ask-user-answer {
    color: $text-primary;
    padding-left: 3;
}

.question-option {
    color: $text-primary;
}

.question-option-selected {
    color: $info;
    text-style: bold;
}