/* ========================================
   JARVIS — ansi-dark Theme
   ======================================== */
$peach: ansi_bright_yellow;
$accent: ansi_blue;
$text: ansi_default;
$overlay: ansi_bright_black;
$muted: ansi_bright_black;
$error: ansi_red;
$recording: ansi_red;
$success: ansi_green;
$warning: ansi_yellow;
$user: ansi_bright_yellow;
$surface: transparent;
$subtext: ansi_bright_black;
$text-muted: ansi_bright_black;
$info: ansi_cyan;

* {
    scrollbar-color: black;
    scrollbar-color-hover: ansi_bright_black;
    scrollbar-color-active: ansi_bright_black;
    scrollbar-background: transparent;
    scrollbar-background-hover: transparent;
    scrollbar-background-active: transparent;
    scrollbar-size: 1 1;
}

Screen {
    background: transparent;
}

Horizontal {
    width: 100%;
    height: auto;
}

TextArea > .text-area--cursor {
    color: ansi_default;
}

#chat {
    layout: vertical;
    height: 1fr;
    width: 100%;
    background: transparent;
    padding: 0 2;
    align-vertical: bottom;
}

#loading-area {
    height: auto;
    width: 100%;
    background: transparent;
    padding: 1 2 0 2;
    layout: horizontal;
    align: left middle;
}

#loading-area-content {
    width: 1fr;
    height: auto;
    align: left middle;
}

#bottom-app-container,
#input-container {
    height: auto;
    width: 100%;
    background: transparent;
}

#bottom-bar {
    height: auto;
    width: 100%;
    background: transparent;
    padding: 0 2;
    align: left middle;
    layout: horizontal;
}

#spacer {
    width: 1fr;
    height: auto;
    background: transparent;
}

#messages {
    layout: vertical;
    width: 100%;
    height: auto;
    text-align: left;
    margin-top: 1;
    margin-bottom: 0;
    padding: 0 1;
}

#input-container {
    padding: 0;
    margin: 0;
}

#completion-popup {
    overlay: screen;
    constrain: inside inside;
    display: none;
    width: auto;
    height: auto;
    color: ansi_default;
    background: transparent;
    border: solid ansi_bright_black;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
    /* max-height, max-width and padding set in completion_popup.py */
}

#completion-popup _CompletionItem {
    height: auto;
    width: 1fr;
}

#input-box {
    height: auto;
    width: 100%;
    background: transparent;
    border: round ansi_bright_black;
    border-title-align: right;
    border-title-color: $accent;
    padding: 0 1;

    &.border-warning {
        border: round $warning;
        border-title-color: $warning;
    }

    &.border-safe {
        border: round $success;
        border-title-color: $success;
    }

    &.border-error {
        border: round $error;
        border-title-color: $error;
    }

    &.border-recording {
        border: round $peach;
        border-title-color: $peach;
    }

    &.border-remote {
        border: round $peach;
        border-title-color: $peach;
    }
}

#input-body {
    height: auto;
}

#prompt,
#prompt-spinner,
#recording-indicator {
    width: auto;
    background: transparent;
    color: $accent;
    text-style: bold;
    padding: 0 1 0 0;
}

#input {
    width: 1fr;
    height: auto;
    min-height: 3;
    max-height: 50vh;
    background: transparent;
    color: $text;
    border: none;
    padding: 0;
    scrollbar-visibility: hidden;

    &.recording {
        color: $muted;
    }
}

ToastRack {
    align: left bottom;
    padding: 0;
    margin: 0 0 6 0;
}

Markdown {
    color: $text;

    .code_inline {
        color: $peach;
        background: transparent;
        text-style: bold;
    }

    MarkdownFence {
        overflow-x: auto;
        scrollbar-size-horizontal: 1;
        max-width: 95%;
        background: transparent;
        border: solid $overlay;
        padding: 1;

        & > Label {
            padding: 0;
        }
    }

    MarkdownTable {
        background: transparent;
    }

    MarkdownBlockQuote {
        background: transparent;
        border-left: outer $accent;
        padding-left: 1;
    }

    MarkdownBullet,
    MarkdownBulletList,
    MarkdownOrderedList {
        color: $text;
    }

    MarkdownH1, MarkdownH2, MarkdownH3 {
        color: $accent;
        text-style: bold;
    }
}

.user-message {
    margin-top: 1;
    width: 100%;
    height: auto;

    &.pending {
        .user-message-prompt,
        .user-message-content {
            opacity: 0.7;
            text-style: italic;
        }
    }
}

.user-message-container {
    width: 100%;
    height: auto;
}

.user-message-prompt {
    width: auto;
    height: 100%;
    text-style: bold;
}

.user-message-container {
    width: 100%;
    height: auto;
}

.user-message-prompt {
    width: auto;
    height: 100%;
    text-style: bold;
}

.user-message-content {
    width: 1fr;
    height: auto;
    text-style: bold;
    padding: 0 1;
    border-left: heavy $user;
    color: $user;
    background: transparent;
}

.assistant-message {
    layout: stream;
    margin-top: 1;
    width: 100%;
    height: auto;
    padding: 0 1;
    border-left: heavy $accent;

    Markdown {
        width: 100%;
        height: auto;
        padding: 0;
        margin: 0;

        & > MarkdownBlock:last-child {
            margin-bottom: 0;
        }
    }
}

.reasoning-message {
    margin-top: 1;
    width: 100%;
    height: auto;

    .reasoning-message-content {
        Markdown {
            width: 100%;
            height: auto;
            padding: 0;
            margin: 0;

            & > MarkdownBlock:last-child {
                margin-bottom: 0;
            }
        }
    }
}

.reasoning-message-wrapper {
    width: 100%;
    height: auto;
}

.reasoning-message-header {
    width: 100%;
    height: auto;
    layout: horizontal;
}

.reasoning-indicator {
    width: auto;
    height: auto;
    color: #c9d7f2;
    margin-right: 1;
}

.reasoning-label {
    width: auto;
    height: auto;
    color: #c9d7f2;
}

.reasoning-branch {
    width: auto;
    height: auto;
    color: #6c6c6c;
    margin-right: 1;
}

.reasoning-message-content-row {
    width: 100%;
    height: auto;
    layout: horizontal;
}

.reasoning-message-content {
    layout: stream;
    width: 100%;
    height: auto;
    padding: 0 0 0 0;
    margin: 0;
    color: #6c6c6c;
    text-style: italic;
    background: transparent;

    * {
        color: #6c6c6c;
        text-style: italic;
    }

    & > MarkdownBlock:last-child {
        margin-bottom: 0;
    }
}

.interrupt-message,
.error-message,
.warning-message,
.user-command-message {
    margin-top: 0;
    margin-bottom: 0;
    height: auto;
    width: 100%;
}

.interrupt-container,
.error-container,
.warning-container,
.user-command-container {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
}

.interrupt-border,
.error-border,
.warning-border,
.user-command-border {
    width: auto;
    height: 100%;
    padding: 0 1 0 2;
    color: $muted;
}

.interrupt-content {
    width: 1fr;
    height: auto;
    margin: 0;
    color: $warning;
}

.error-content {
    width: 1fr;
    height: auto;
    margin: 0;
    color: $error;
    text-style: bold;
}

.warning-content {
    width: 1fr;
    height: auto;
    margin: 0;
    color: $warning;
}

.user-command-content {
    width: 1fr;
    height: auto;
    margin: 0;

    Markdown {
        margin: 0;
        padding: 0;

        & > MarkdownBlock:first-child {
            margin-top: 0;
        }

        & > MarkdownBlock:last-child {
            margin-bottom: 0;
        }
    }
}

.bash-output-message {
    margin-top: 1;
    width: 100%;
    height: auto;

    &:first-child {
        margin-top: 0;
    }
}

.bash-command-line {
    width: 100%;
    height: auto;
    margin: 0;
}

.bash-prompt {
    width: auto;
    height: auto;

    &.bash-success {
        color: $success;
    }

    &.bash-error {
        color: $error;
    }
}

.bash-command {
    width: 1fr;
    height: auto;
}

.bash-output-container {
    width: 100%;
    height: auto;
    margin: 0;
}

.bash-output-border {
    width: auto;
    height: 100%;
    padding: 0 1 0 2;
    color: ansi_bright_black;
}

.bash-output {
    width: 1fr;
    height: auto;
}

.unknown-event {
    height: auto;
    color: ansi_bright_black;
}

StatusMessage {
    width: 100%;
    height: auto;

    Horizontal {
        width: 100%;
        height: auto;
    }
}

.status-indicator-icon {
    width: auto;
    height: auto;
    color: ansi_bright_black;
    margin-right: 1;

    &.success {
        color: ansi_green;
    }

    &.error {
        color: ansi_red;
    }
}

.status-indicator-text {
    width: 1fr;
    height: auto;
    color: ansi_default;
}

.compact-message,
.tool-call {
    width: 100%;
    height: auto;
    margin-top: 1;
    background: transparent 30%;
    border-left: wide $info;
    padding: 0 1;
}

.tool-call.no-gap {
    margin-top: 0;
}

.tool-call-container {
    width: 100%;
    height: auto;
}

.tool-stream-message {
    width: 100%;
    height: auto;
    color: $subtext;
    padding-left: 2;
}

.tool-result {
    width: 100%;
    height: auto;
    margin-top: 0;
    margin-left: 0;
    padding: 0 1;
    background: transparent 25%;
    color: $text;
    border-left: wide $success;

    &.error-text {
        color: $error;
        border-left: wide $error;
    }

    &.warning-text {
        color: $warning;
        border-left: wide $warning;
    }
}

.tool-result-container {
    width: 100%;
    height: auto;
    margin-top: 0;
    padding: 0;
}

.tool-result-border {
    width: auto;
    height: 100%;
    padding: 0 1 0 2;
    color: ansi_bright_black;
}

.tool-result-content {
    width: 1fr;
    height: auto;
    padding: 0;
}

.tool-call-widget,
.tool-result-widget {
    width: 100%;
    height: auto;
    color: ansi_default;
}

.tool-result-widget:focus {
    background: ansi_bright_black 10%;
}

.tool-result-widget Static {
    height: auto;
}

.tool-result-widget Markdown,
.tool-approval-widget Markdown {
    padding: 0;
    margin: 0;
}

.tool-result-widget Markdown > *,
.tool-approval-widget Markdown > * {
    margin-top: 0;
    margin-bottom: 0;
}

.tool-result-widget Markdown MarkdownFence,
.tool-approval-widget Markdown MarkdownFence {
    margin: 0;
    padding: 0;
}

.tool-call-detail,
.tool-result-detail {
    height: auto;
    color: ansi_bright_black;
}

.tool-call-detail {
    padding-left: 2;
}

.tool-result-detail {
    margin-top: 0;
}

.tool-result-error {
    color: $error;
}

.tool-result-warning {
    color: $warning;
}

.tool-result-summary {
    color: $text;
    text-style: bold;
}

.tool-result-summary.clickable {
    color: $info;
    text-style: bold;
    background: transparent 40%;
    padding: 0 1;
}

.tool-result-summary.clickable:hover {
    background: transparent 60%;
    color: $text;
}

.tool-result-file-header {
    color: $info;
    text-style: bold;
    margin-top: 1;
}

.tool-result-match {
    color: $subtext;
    padding-left: 2;
}

.tool-result-hint {
    color: $subtext;
    text-style: italic;
}

.tool-result-muted {
    color: $subtext;
}

.diff-header {
    height: auto;
    color: $muted;
    text-style: bold;
}

.diff-removed {
    height: auto;
    color: ansi_red;
}

.diff-added {
    height: auto;
    color: ansi_green;
}

.diff-range {
    height: auto;
    color: ansi_blue;
}

.diff-context {
    height: auto;
    color: $muted;
}

.todo-empty,
.todo-cancelled {
    height: auto;
    color: ansi_bright_black;
}

.todo-pending {
    height: auto;
    color: ansi_default;
}

.todo-in_progress {
    height: auto;
    color: ansi_yellow;
}

.todo-completed {
    height: auto;
    color: ansi_green;
}

.loading-widget {
    width: 100%;
    height: auto;
    color: $subtext;
    background: transparent 30%;
    padding: 0 1;
    border-left: wide $accent;
}

.loading-container,
.loading-indicator,
.loading-status,
.loading-hint {
    width: auto;
    height: auto;
}

.loading-indicator {
    margin-right: 1;
}

.loading-status {
    width: auto;
    height: auto;
}

.loading-char {
    width: auto;
    height: auto;
}

.loading-hint {
    width: auto;
    height: auto;
    color: ansi_bright_black;

}

.history-load-more-message {
    width: 100%;
    height: auto;
    text-align: center;
    content-align: center middle;
    margin: 1 0;
}

.history-load-more-container {
    width: 100%;
    height: auto;
    content-align: center middle;
}

.history-load-more-button {
    background: transparent;
    border: none;
    color: $warning;
    text-style: bold;
    pointer: pointer;
    padding: 1;
}

.history-load-more-button:hover {
    color: $accent;
}

#config-app, #voice-app, #mcp-app, #connectorauth-app {
    width: 100%;
    height: auto;
    background: transparent;
    border: solid $overlay;
    padding: 0 1;
    margin: 0;
}

#config-content, #voice-content, #mcp-content, #connectorauth-content {
    width: 100%;
    height: auto;
}

.settings-title {
    height: auto;
    text-style: bold;
    color: $accent;
}

#config-options, #mcp-options, #connectorauth-options {
    width: 100%;
    max-height: 50vh;
    border: none;
}

#config-options:focus, #mcp-options:focus, #connectorauth-options:focus {
    border: none;
}

#connectorauth-detail {
    margin: 1 0;
}

.settings-help {
    height: auto;
    color: ansi_bright_black;
}

#proxysetup-app {
    width: 100%;
    height: auto;
    background: transparent;
    border: solid ansi_bright_black;
    padding: 0 1;
    margin: 0;
}

#proxysetup-content {
    width: 100%;
    height: auto;
}

.proxy-label-line {
    height: auto;
}

.proxy-input {
    width: 100%;
    height: auto;
    border: none;
    border-left: wide ansi_bright_black;
    padding: 0 0 0 1;
}

.code-block {
    height: auto;
    color: ansi_default;
    background: transparent;
    padding: 1;
}

#question-app {
    width: 100%;
    height: auto;
    max-height: 70vh;
    background: transparent;
    border: solid $overlay;
    padding: 0 1;
    margin: 0;
}

#question-content {
    width: 100%;
    height: auto;
}

#question-content.question-content-docked {
    dock: bottom;
}

.question-tabs {
    height: auto;
    color: $info;
    margin-bottom: 1;
}

.question-title {
    height: auto;
    text-style: bold;
    color: $info;
    margin-bottom: 1;
}

.question-option {
    height: auto;
    color: $text;
}

.question-option-selected {
    color: $info;
    text-style: bold;
}

.question-other-row {
    width: 100%;
    height: auto;
}

.question-other-prefix {
    width: auto;
    height: auto;
    color: ansi_default;
}

.question-other-input {
    width: 1fr;
    height: auto;
    background: transparent;
    border: none;
    padding: 0;
}

.question-other-static {
    width: auto;
    height: auto;
    color: ansi_bright_black;
}

.question-submit {
    height: auto;
    color: ansi_default;
    margin-top: 1;
}

.question-help {
    height: auto;
    color: ansi_bright_black;
    margin-top: 1;
}

.question-content-preview {
    width: 100%;
    height: auto;
    max-height: 50vh;
    border: none;
    border-left: wide ansi_bright_black;
    padding: 0 0 0 1;
    margin-bottom: 1;
}

.question-content-preview-text {
    width: 100%;
    height: auto;
    color: ansi_default;
    padding: 0;
    margin: 0;

    & > MarkdownBlock:last-child {
        margin-bottom: 0;
    }
}

ExpandingBorder {
    width: auto;
    height: 100%;
    content-align: left bottom;
}

PathDisplay,
ContextProgress {
    width: auto;
    height: auto;
    background: transparent;
    padding: 0;
    margin: 0;
    color: ansi_bright_black;
}

NarratorStatus {
    width: auto;
    height: auto;
    background: transparent;
    padding: 0;
    margin: 0 0 0 1;
}

#banner-container {
    align: left middle;
    padding: 0 2 0 1;
    width: auto;
    height: auto;
    background: transparent;
}

.banner-chat {
    width: auto;
}

#banner-info {
    width: auto;
    height: auto;
    margin-left: 2;
    content-align: left middle;
    padding: 0 1 0 0;
}

.banner-line {
    width: auto;
    height: auto;
}

.banner-title-row {
    height: auto;
    margin-bottom: 0;
}

.banner-meta-row {
    height: auto;
    margin-top: 0;
}

#banner-brand {
    color: $accent;
    text-style: bold;
    width: auto;
    background: transparent;
    padding: 0 1 0 0;

}

#banner-version {
    color: $success;
    width: auto;
    padding: 0 1;
    text-style: bold;
}

#banner-model {
    color: $info;
    width: auto;
    max-width: 28;
    overflow: hidden;
    text-overflow: ellipsis;
    text-style: italic;
}

#banner-user-plan {
    width: auto;
}

#banner-meta-counts {
    width: auto;
    color: $text-muted;
    padding: 0 1 0 0;
}

#banner-attribution {
    width: auto;
    color: $text-muted;
    text-align: right;
    padding: 0 0 0 2;
}

.petit-chat {
    color: $text;
    width: 13;
}

.whats-new-message {
    border-left: heavy $accent;
    margin-bottom: 1;
    background: transparent 30%;

    Markdown {
        padding: 0 0 0 1;
        margin: 0;

        & > MarkdownBlock:first-child {
            margin-top: 0;
        }

        & > MarkdownBlock:last-child {
            margin-bottom: 0;
        }

        MarkdownBulletList,
        MarkdownOrderedList {
            margin-top: 1;
            margin-bottom: 1;
        }

        MarkdownH1 {
            content-align: left middle;
        }
    }

    link-style: none;
    link-background-hover: transparent;
    link-style-hover: underline;
    link-color-hover: $accent;
}

.whats-new-message.after-history {
    margin-top: 1;
}

#sessionpicker-app {
    width: 100%;
    height: auto;
    background: transparent;
    border: solid $overlay;
    padding: 0 1;
    margin: 0;
}

#sessionpicker-content {
    width: 100%;
    height: auto;
}

#sessionpicker-options {
    width: 100%;
    max-height: 50vh;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
}

#sessionpicker-options:focus {
    border: none;
}

.sessionpicker-help {
    width: 100%;
    height: auto;
    color: $muted;
    margin-top: 1;
}

/* Timing Message */
.timing-message {
    margin-top: 0;
    width: 100%;
    height: auto;
}

.timing-container {
    width: 100%;
    height: auto;
    layout: horizontal;
}

.timing-indicator {
    width: auto;
    height: auto;
    margin-right: 1;
}

.timing-text {
    width: 1fr;
    height: auto;
    color: $muted;
}

/* Diff Block */
.diff-block {
    width: 100%;
    height: auto;
}

.diff-file-header {
    width: 100%;
    height: auto;
    color: ansi_cyan;
    text-style: bold;
    padding-left: 1;
}

.diff-border {
    width: 100%;
    height: auto;
    color: ansi_bright_black;
}

.diff-hunk-header {
    width: 100%;
    height: auto;
    color: ansi_bright_magenta;
    text-style: italic;
}

.diff-line {
    width: 100%;
    height: auto;
}

.diff-line-number {
    width: auto;
    height: auto;
    color: ansi_bright_black;
}

.diff-line-content {
    width: 1fr;
    height: auto;
}

.diff-line-content.diff-added {
    color: ansi_green;
}

.diff-line-content.diff-removed {
    color: ansi_red;
}

.diff-line-content.diff-context {
    color: ansi_default;
}

.diff-summary {
    width: 100%;
    height: auto;
    color: ansi_bright_black;
    text-style: bold;
}

/* Tool Stats Widget */
.tool-stats-widget {
    width: 100%;
    height: auto;
    layout: horizontal;
}

.tool-stats-container {
    width: 100%;
    height: auto;
    layout: horizontal;
}

.tool-stats-numbers {
    width: auto;
    height: auto;
    color: ansi_green;
    margin-right: 1;
}

.tool-stats-bar {
    width: auto;
    height: auto;
    color: ansi_green;
    margin-right: 1;
}

.tool-stats-location {
    width: auto;
    height: auto;
    color: ansi_bright_black;
}

#debug-console {
    dock: right;
    width: 40%;
    max-width: 80;
    min-width: 40;
    height: 100%;
    background: transparent;
    border-left: solid $overlay;
    padding: 0 1;
}

#debug-console-header {
    width: 100%;
    height: auto;
    color: $text;
    padding: 0 0 1 0;
    text-align: left;
}

#debug-console-log {
    width: 100%;
    height: 1fr;
    background: transparent;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

#modelpicker-app {
    width: 100%;
    height: auto;
    background: transparent;
    border: solid ansi_bright_black;
    padding: 0 1;
    margin: 0;
}

#modelpicker-content {
    width: 100%;
    height: auto;
}

.modelpicker-title {
    height: auto;
    text-style: bold;
    color: $accent;
}

#modelpicker-options {
    width: 100%;
    max-height: 50vh;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
}

#modelpicker-options:focus {
    border: none;
}

.modelpicker-help {
    width: 100%;
    height: auto;
    color: $muted;
    margin-top: 1;
}

#thinkingpicker-app {
    width: 100%;
    height: auto;
    background: transparent;
    border: solid ansi_bright_black;
    padding: 0 1;
    margin: 0;
}

#thinkingpicker-content {
    width: 100%;
    height: auto;
}

.thinkingpicker-title {
    height: auto;
    text-style: bold;
    color: $accent;
}

#thinkingpicker-options {
    width: 100%;
    max-height: 50vh;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
}

#thinkingpicker-options:focus {
    border: none;
}

.thinkingpicker-help {
    width: 100%;
    height: auto;
    color: $muted;
    margin-top: 1;
}

FeedbackBar {
    width: auto;
    height: auto;
    margin-left: 1;
}

.user-message.rewind-selected {
    .user-message-content {
        text-style: bold reverse;
        color: ansi_bright_cyan;
        background: ansi_cyan;
    }
}

#rewind-app {
    width: 100%;
    height: auto;
    background: transparent;
    border: tall $accent;
    padding: 1 2;
    margin: 0;
}

#rewind-content {
    width: 100%;
    height: auto;
}

#rewind-header {
    width: 100%;
    height: auto;
    layout: horizontal;
}

.rewind-title {
    width: 1fr;
    height: auto;
    text-style: bold;
    color: $accent;
}

.rewind-counter {
    width: auto;
    height: auto;
    color: $muted;
    text-style: italic;
}

.rewind-separator {
    height: auto;
    color: $overlay;
}

.rewind-option {
    height: auto;
    color: ansi_default;
    padding: 0 1;
}

.rewind-cursor-selected {
    color: ansi_bright_cyan;
    text-style: bold;
    background: $overlay;
}

.rewind-option-unselected {
    color: ansi_default;
}

.rewind-help {
    height: auto;
    color: $muted;
    padding-top: 1;
}

#feedback-text {
    width: auto;
    height: auto;
    color: $text;
}

.hook-system-message {
    height: auto;
    width: 100%;
    margin-top: 0;
    margin-bottom: 0;
}

.hook-run-container {
    height: auto;
    width: 100%;
    margin-top: 1;
}

.hook-run-container:empty {
    display: none;
}

.hook-system-container {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
}

.hook-system-icon {
    width: auto;
    height: 1;
    padding: 0 1 0 0;
}

.hook-system-content {
    width: 1fr;
    height: auto;
    max-height: 3;
    overflow: hidden;
    color: $muted;
}

.hook-severity-ok .hook-system-icon {
    color: ansi_green;
}

.hook-severity-warning .hook-system-icon {
    color: ansi_yellow;
}

.hook-severity-error .hook-system-icon {
    color: ansi_red;
}

/* Tool Call Message (target design) */
.tool-call {
    margin-top: 1;
    width: 100%;
    height: auto;
}

.tool-call-container {
    width: 100%;
    height: auto;
}

.tool-call-header {
    width: 100%;
    height: auto;
    layout: horizontal;
}

.tool-indicator {
    width: auto;
    height: auto;
    color: $text;
    margin-right: 1;
}

.tool-indicator.success {
    color: $success;
}

.tool-indicator.error {
    color: $error;
}

.tool-call-info {
    width: 100%;
    height: auto;
    layout: horizontal;
}

.tool-info-marker {
    width: auto;
    height: auto;
    color: $muted;
    margin-right: 1;
}

.tool-info {
    width: 1fr;
    height: auto;
    color: $muted;
}

.tool-name {
    width: auto;
    height: auto;
    color: $text;
    text-style: bold;
    margin-right: 1;
}

.tool-call-args {
    width: auto;
    height: auto;
    color: $subtext;
    margin-right: 1;
}

.tool-call-duration {
    width: auto;
    height: auto;
    color: $muted;
    text-style: italic;
}

/* Tool Result Message (target design) */
.tool-result {
    margin-top: 0;
    width: 100%;
    height: auto;
}

.tool-result-container {
    width: 100%;
    height: auto;
}

.tool-result-header {
    width: 100%;
    height: auto;
    layout: horizontal;
}

.tool-result-indicator {
    width: auto;
    height: auto;
    margin-right: 1;
}

.tool-result-indicator.success {
    color: $success;
}

.tool-result-indicator.error {
    color: $error;
}

.tool-result-name {
    width: auto;
    height: auto;
    text-style: bold;
}

.tool-stats {
    width: auto;
    height: auto;
    color: $muted;
}

/* ========================================
   Phase 5: Visual Polish & Interactive States
   ======================================== */

/* Tool call hover/active states */
.tool-call:focus-within .tool-call-header {
    color: $accent;
}

/* Tool result interactive expand/collapse */
.tool-result-summary.clickable:focus {
    color: $accent;
    text-style: bold italic;
}

/* Diff block polish — subtle left border for diff regions */
.diff-block {
    border-left: outer $overlay;
    padding-left: 1;
}

/* Diff file header with accent background */
.diff-file-header {
    background: $accent 10%;
    padding: 0 1;
}

/* Diff summary bar polish */
.diff-summary {
    background: $overlay 20%;
    padding: 0 1;
    margin-top: 1;
}

/* Approval action card focus */
/* Tool indicator pulse animation (via class toggle, no CSS animation for terminal compat) */
.tool-indicator.running {
    color: $warning;
}

/* Consistent vertical rhythm — tool call/result pairs */
.tool-call {
    margin-bottom: 0;
}

/* Collapsed tool results get a subtle left accent */
.tool-result-widget.collapsed {
    border-left: tall $accent 30%;
}

/* Error state polish */
.tool-result-error {
    background: $error 8%;
    padding: 0 1;
}

/* Warning state polish */
.tool-result-warning {
    background: $warning 8%;
    padding: 0 1;
}

