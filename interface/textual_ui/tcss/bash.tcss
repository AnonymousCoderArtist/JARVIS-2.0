/* ========================================
   Bash Widget Modern Styles
   ======================================== */

/* Bash Approval Widget - Enhanced */
.approval-tool-name {
    height: auto;
    color: ansi_bright_cyan;
    text-style: bold;
    margin-left: 0;
}

.approval-bash-command {
    height: auto;
    margin-left: 2;
    margin-top: 1;
}

.approval-bash-param {
    height: auto;
    color: ansi_bright_black;
    margin-left: 2;
}

/* Bash Result Widget - Modern card-style display */
.bash-exit-code {
    color: ansi_bright_black;
    padding-left: 2;
}

.bash-exit-code:light {
    color: ansi_bright_black;
}

.bash-stdout {
    height: auto;
    padding-left: 3;
    margin-left: 0;
}

.bash-stderr {
    color: ansi_bright_red;
    background: ansi_red 5%;
    padding: 0 1;
    margin-left: 3;
    border-left: thick ansi_bright_red;
}

.tool-result-error {
    color: ansi_bright_red;
    padding-left: 5;
    margin-left: 0;
}
