/* ========================================
   LS Widget Modern Styles
   ======================================== */

.tool-result-ls-item {
    padding-left: 5;
    margin-left: 0;
}

.tool-result-ls-dir {
    color: ansi_bright_cyan;
    text-style: bold;
}

.tool-result-ls-file {
    color: ansi_white;
}

.tool-result-ls-hint {
    color: ansi_bright_black;
    padding-left: 5;
    margin-left: 0;
    text-style: italic;
}
