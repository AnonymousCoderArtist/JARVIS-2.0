/* ========================================
   JARVIS Color Palette
   ======================================== */
$accent: ansi_blue;
$surface: transparent;
$surface-light: transparent;
$text-primary: ansi_default;
$text-secondary: ansi_bright_black;
$border-subtle: black;
$border-focus: ansi_yellow;
$success: ansi_green;
$warning: ansi_yellow;
$error: ansi_red;
$info: ansi_cyan;

/* ========================================
   Tool Widgets Modern Styles
   ======================================== */

/* Generic Tool Result Widget */
.tool-result-widget {
    width: 100%;
    height: auto;
    color: $text-primary;
}

.tool-result-widget:focus {
    background: transparent;
}

/* Branch indicator for collapsed summaries */
.tool-result-summary {
    color: $text-primary;
    text-style: bold;
    padding-left: 2;
}

.tool-result-summary.collapsed {
    color: $info;
    background: transparent;
    padding: 0 1;
}

.tool-result-summary.clickable {
    color: $info;
    text-style: bold;
    background: transparent;
    padding: 0 1;
}

.tool-result-summary.clickable:hover {
    background: transparent;
    color: $text-primary;
}

/* Muted text for empty states */
.tool-result-muted {
    color: $text-secondary;
    padding-left: 2;
}

/* Hint text */
.tool-result-hint {
    color: $text-secondary;
    text-style: italic;
    padding-left: 5;
}

/* Detail text */
.tool-result-detail {
    color: $text-secondary;
    padding-left: 2;
}

/* Warning/Error text */
.tool-result-warning {
    color: $warning;
    padding-left: 2;
}

.tool-result-error {
    color: $error;
    padding-left: 2;
}

/* Error text styling */
.error-text {
    color: $error;
}

.warning-text {
    color: $warning;
}

/* ========================================
   Bash Tool Styles
   ======================================== */

.approval-bash-command {
    height: auto;
    margin-left: 2;
    margin-top: 1;
    color: $success;
    background: transparent;
    padding: 0 1;
}

.approval-bash-param {
    height: auto;
    color: $text-secondary;
    margin-left: 2;
}

.bash-success {
    color: $text-secondary;
}

.bash-error {
    color: $error;
}

.bash-output-line {
    color: $text-secondary;
    padding-left: 3;
}

/* ========================================
   Grep Tool Styles
   ======================================== */

.approval-grep-query {
    height: auto;
    color: ansi_bright_green;
    text-style: bold;
    margin-left: 2;
}

.approval-grep-param {
    height: auto;
    color: ansi_bright_black;
    margin-left: 2;
}

.tool-result-match {
    color: $text-primary;
    padding-left: 5;
    background: transparent;
}

.tool-result-file-header {
    color: $info;
    text-style: bold;
    padding-left: 3;
}

.tool-result-label {
    color: $text-secondary;
    text-style: bold;
    padding-left: 2;
}

/* ========================================
   LS Tool Styles
   ======================================== */

.tool-result-ls-item {
    padding-left: 5;
    margin-left: 0;
}

.tool-result-ls-dir {
    color: $info;
    text-style: bold;
}

.tool-result-ls-file {
    color: $text-primary;
}

.tool-result-ls-hint {
    color: $text-secondary;
    padding-left: 5;
    margin-left: 0;
    text-style: italic;
}

/* ========================================
   Find Tool Styles
   ======================================== */

/* Find uses same styles as LS */

/* ========================================
   Read File Tool Styles
   ======================================== */

.approval-read-file-count {
    color: $success;
    text-style: bold;
}

.tool-result-read-summary {
    color: $text-secondary;
    padding-left: 2;
}

.tool-result-read-warning {
    color: $warning;
    padding-left: 5;
}

/* ========================================
   Write File Tool Styles
   ======================================== */

/* Write uses same styles as Read */

/* ========================================
   Todo Tool Styles
   ======================================== */

.todo-in_progress {
    color: $warning;
}

.todo-pending {
    color: $text-primary;
}

.todo-completed {
    color: $success;
}

.todo-cancelled,
.todo-empty {
    color: $text-secondary;
}

/* ========================================
   Ask User Question Styles
   ======================================== */

.ask-user-answer {
    color: $text-primary;
    padding-left: 3;
}

.question-option {
    color: $text-primary;
}

.question-option-selected {
    color: $info;
    text-style: bold;
}

/* ========================================
   Agent Tool Styles
   ======================================== */

.agent-tool-call-container {
    width: 100%;
}

.agent-tool-call-header {
    width: 100%;
    padding: 0;
}

.agent-tool-indicator {
    width: 3;
    text-align: center;
    color: $info;
}

.agent-tool-indicator.success {
    color: $success;
}

.agent-tool-indicator.error {
    color: $error;
}

.agent-tool-name {
    width: auto;
    color: $text-primary;
    text-style: bold;
}

.agent-tool-info {
    color: $text-secondary;
    padding-left: 3;
}

.agent-tool-result-container {
    width: 100%;
}

.agent-tool-result-header {
    width: 100%;
    padding: 0;
}

.agent-tool-result-indicator {
    width: 3;
    text-align: center;
}

.agent-tool-result-indicator.success {
    color: $success;
}

.agent-tool-result-indicator.error {
    color: $error;
}

.agent-tool-result-name {
    width: auto;
    color: $text-primary;
    text-style: bold;
}

.agent-tool-status {
    color: $text-secondary;
}

.agent-tool-result-content {
    width: 100%;
    padding-left: 3;
}

.agent-tool-result-line {
    color: $text-primary;
}

.agent-tool-result-error {
    color: $error;
}

.agent-tool-result-hint {
    color: $text-secondary;
    text-style: italic;
}

/* Collapsed state for agent tools */
.agent-tool-result-widget {
    width: 100%;
}

.agent-tool-result-widget:focus {
    background: transparent;
}

.agent-tool-result-summary {
    color: $text-primary;
    text-style: bold;
    padding-left: 1;
}

.agent-tool-result-summary.clickable {
    color: $info;
    text-style: bold;
    background: transparent;
}

.agent-tool-result-summary.clickable:hover {
    background: transparent;
    color: $text-primary;
}

/* ========================================
   Agent Overlay Styles
   --------------------------------------------------
   The active styles for the sub-agent overlay live in
   interface/textual_ui/widgets/subagent_viewer.py
   and are scoped to the SubagentOverlay screen.
   ======================================== */

/* Agent Tree Widget Styles */
.agent-tree-widget {
    width: 100%;
    margin: 0 0 1 0;
}

.agent-tree-container {
    width: 100%;
}

.agent-tree-header {
    color: $text-primary;
    text-style: bold;
    padding: 0 0 0 1;
}

.agent-tree-item {
    color: $text-primary;
    padding-left: 1;
}

.agent-tree-item.status-running {
    color: $text-primary;
}

.agent-tree-item.status-completed {
    color: $success;
}

.agent-tree-item.status-failed {
    color: $error;
}

.agent-tree-action {
    color: $text-secondary;
    padding-left: 1;
    text-style: italic;
}

.agent-tree-queued {
    color: $text-secondary;
    padding-left: 1;
    text-style: italic;
}

.agent-tree-empty {
    color: $text-secondary;
    padding-left: 1;
    text-style: italic;
}

.agent-tree-branch {
    color: $text-secondary;
}