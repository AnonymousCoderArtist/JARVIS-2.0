# JARVIS 2.0 Environment Configuration

# Application Settings
APP_NAME=JARVIS
APP_VERSION=2.0.0
DEBUG=false

# LLM Provider Settings
DEFAULT_PROVIDER=mistral

# Mistral Configuration
MISTRAL_API_KEY=CxNm75EcfZUC300AByktbQku4eFpsud1

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Provider Models
PROVIDER_MODELS={"mistral": "mistral-large-latest", "openai": "gpt-4o", "anthropic": "claude-3-5-sonnet-20241022"}

# Memory Settings
MAX_MEMORY_ENTRIES=1000
MEMORY_IMPORTANCE_THRESHOLD=0.5
MAX_CONVERSATION_HISTORY=50

# RAG Settings
RAG_ENABLED=true
MAX_RAG_RESULTS=5
RAG_SIMILARITY_THRESHOLD=0.7

# Safety Settings
REQUIRE_CONFIRMATION=true
AUTO_CHECKPOINT=true
MAX_CHECKPOINTS=10

# Tool Settings
ENABLE_CODE_EXECUTION=true
ENABLE_FILE_OPERATIONS=true
ENABLE_GIT_OPERATIONS=true

# Interface Settings
CLI_PROMPT="JARVIS > "
