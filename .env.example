# JARVIS Configuration
# Copy this file to .env and fill in your values

# LLM Provider Configuration
# You can also use CLI flags: --model, --base_url, --apikey, --sdk

# Model name (e.g., gpt-4o, claude-3-5-sonnet-20241022)
JARVIS_MODEL=gpt-4o

# Base URL for the LLM API (e.g., https://api.openai.com/v1)
JARVIS_BASE_URL=

# API key for the LLM provider
JARVIS_API_KEY=

# SDK mode (openai or anthropic)
JARVIS_SDK=openai

# Heartbeat Configuration (optional - for periodic agent awareness)
# Creates a nanobot-style two-phase heartbeat system
JARVIS_HEARTBEAT_ENABLED=false    # Enable periodic heartbeat checks (default: false)
JARVIS_HEARTBEAT_EVERY=30m        # Interval: 15m, 30m, 1h, etc. (default: 30m)
JARVIS_HEARTBEAT_TARGET=last      # Target channel for heartbeat output
JARVIS_HEARTBEAT_SKIP_WHEN_BUSY=true  # Skip heartbeat when agent is busy
JARVIS_HEARTBEAT_SHOW_OK=false    # Show HEARTBEAT_OK messages (default: true)

# Token Limits Configuration (optional)
# Default: 128K total context (109K input + 16K output)
# 1K = 1024 tokens

# Maximum total context tokens (default: 131072 = 128K)
JARVIS_MAX_CONTEXT_TOKENS=

# Maximum input tokens (default: 111616 = 109K)
JARVIS_MAX_INPUT_TOKENS=

# Maximum output tokens (default: 16384 = 16K)
JARVIS_MAX_OUTPUT_TOKENS=
